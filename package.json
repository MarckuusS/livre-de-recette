{
  "name": "livre-de-recettes",
  "version": "0.1.0",
  "private": true,
  "description": "Livre de recettes numerique — webapp PWA (Cloudflare Pages + Workers + D1 + R2)",
  "type": "module",
  "workspaces": [
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p web/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "dev:worker": "npm --workspace worker run dev",
    "dev:web": "npm --workspace web run dev",
    "db:migrate:local": "wrangler d1 migrations apply livre-de-recettes --local",
    "db:migrate:remote": "wrangler d1 migrations apply livre-de-recettes --remote",
    "db:check": "node scripts/check-fts5.mjs",
    "db:export": "node scripts/migrate-sqlite-to-d1.mjs",
    "db:verify": "node scripts/migrate-sqlite-to-d1.mjs && node scripts/verify-migration.mjs",
    "db:load:local": "wrangler d1 execute livre-de-recettes --local --file=scripts/_dump/d1-seed.sql",
    "db:load:remote": "wrangler d1 execute livre-de-recettes --remote --file=scripts/_dump/d1-seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^3.105.0"
  },
  "engines": {
    "node": ">=20"
  }
}
